{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "medium"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["pnpm", "dlx", "@playwright/mcp@latest", "--headless", "--isolated"],
