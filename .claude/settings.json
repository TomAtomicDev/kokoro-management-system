{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Read(**/.env*)"
    ],
    "allow": [
      "Skill(playwright-cli)",
      "Skill(run)",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(cd:*)"
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/tommy/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/tommy/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "context-mode statusline"
  }
}