{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Read(**/.env*)"
    ],
    "allow": [
      "Skill(playwright-cli)",
      "Skill(run)",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(cd:*)"
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": false
  },
  "statusLine": {
    "type": "command",
    "command": "context-mode statusline"
  }
}